# Server Configuration
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database
DATABASE_PATH=./database/simplifyed.db

# Session ** openssl rand -base64 128 **
SESSION_SECRET=change-this-to-a-secure-random-string

# Supabase Auth (REQUIRED - Get these from your Supabase project)
# See SUPABASE_AUTH_SETUP.md for detailed setup instructions
# 1. Go to https://app.supabase.com
# 2. Select your project > Settings > API
# 3. Copy the Project URL, anon key, and JWT Secret
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Test Mode (development only) - bypasses auth
TEST_MODE=false
TEST_USER_EMAIL=test@simplifyed.in

# Polling Configuration
INSTANCE_POLL_INTERVAL_MS=15000
MARKET_DATA_POLL_INTERVAL_MS=5000

# OpenAlgo Configuration
# Timeout for all API requests (milliseconds)
OPENALGO_REQUEST_TIMEOUT_MS=15000

# Critical operations (orders, cancellations, position closures)
# - More retries with shorter delays for fast recovery
# - Example: 500ms, 1s, 2s = ~3.5s total delay
OPENALGO_CRITICAL_MAX_RETRIES=3
OPENALGO_CRITICAL_RETRY_DELAY_MS=500

# Non-critical operations (quotes, positions, polling)
# - Fewer retries with longer delays to avoid hammering API
# - Next poll cycle will retry anyway
# - Example: 2s = 2s total delay
OPENALGO_NONCRITICAL_MAX_RETRIES=1
OPENALGO_NONCRITICAL_RETRY_DELAY_MS=2000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# TradingView Broadcast Webhook
# Required: shared token for /webhook/tradingview/broadcast
# TradingView can't send headers on some plans; token can be passed as ?token=<value>
WEBHOOK_TOKEN=your-shared-webhook-token
# Optional: JSON array of downstream targets when NOT using broadcast watchlists
# [
#   { "name": "nyc", "url": "https://nyc.example.com", "apikey": "abc" },
#   { "name": "lon", "url": "https://lon.example.com", "apikey": "def" }
# ]
OPENALGO_TARGETS=[]
# Timeouts/retries for TradingView fan-out (ms, counts)
TRADINGVIEW_BROADCAST_TIMEOUT_MS=3000
TRADINGVIEW_BROADCAST_RETRIES=2
TRADINGVIEW_BROADCAST_RETRY_DELAY_MS=250
TRADINGVIEW_BROADCAST_DEFAULT_RPS=2

# WebSocket Gateway (dashboard push)
WS_GATEWAY_ENABLED=true
WS_GATEWAY_PATH=/stream

# Telegram Bot Configuration
# Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_USERNAME=simplifyed_trading_bot
TELEGRAM_DEFAULT_CHAT_ID=your-default-chat-id
