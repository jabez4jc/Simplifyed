# Simplifyed Admin - environment configuration
# Copy to .env and fill in. Most values are optional; the two marked REQUIRED are not.
#
#   cp .env.example .env
#
# Anything omitted falls back to the default shown here, and database-backed settings
# (Settings screen) override these at runtime for the keys they cover.

# ---------------------------------------------------------------------------
# REQUIRED - the server refuses to start without this
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=                # signs local login tokens, used for REST and the WebSocket gateway

# SESSION_SECRET was removed along with express-session: authentication is a stateless JWT, no
# cookie is issued, and the session store never held a row. An existing line here is ignored.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# NODE_ENV is a LABEL for logs and the startup banner - it does not switch behaviour.
# It defaults to 'development' when unset, so gating anything on it fails open; the things
# that used to depend on it now read what they actually care about instead.
NODE_ENV=development

PORT=3000

# BASE_URL is load-bearing: an https:// scheme is what makes session cookies Secure.
# Set this to your real public URL in production, or cookies go out in the clear.
BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
DATABASE_PATH=./database/simplifyed.db

# ---------------------------------------------------------------------------
# Auth / access
# ---------------------------------------------------------------------------
# Bypasses login entirely and treats every request as an admin, and skips the instruments
# readiness check (leaving /api/v1/ready reporting bypassed + not ready). NEVER enable in
# production. This is the ONLY switch that disables authentication - a second variable,
# TEST_MODE, used to do the same thing independently and has been removed.
ENABLE_TEST_MODE=false

# ---------------------------------------------------------------------------
# TradingView broadcast webhook
# ---------------------------------------------------------------------------
# The ONLY auth on POST /webhook/tradingview/broadcast, which places live orders.
# Treat as a trading credential. Send as the X-Webhook-Token header or ?token= query param.
# Leave empty to disable the endpoint (it rejects every request when unset).
WEBHOOK_TOKEN=

# Percentage buffer applied to limit prices on broadcast orders.
TRADINGVIEW_BUFFER_PCT_DEFAULT=0.5
# Optional per-strategy override, JSON object: {"strategy-name": 0.75}
TRADINGVIEW_BUFFER_BY_STRATEGY={}

# ---------------------------------------------------------------------------
# Telegram alerting (optional)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DEFAULT_CHAT_ID=
# If set, the webhook route requires Telegram's X-Telegram-Bot-Api-Secret-Token header to
# match. Must also be passed as secret_token when calling Telegram's setWebhook API.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Polling intervals (ms)
# ---------------------------------------------------------------------------
INSTANCE_POLL_INTERVAL_MS=15000
MARKET_DATA_POLL_INTERVAL_MS=5000
HEALTH_CHECK_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# OpenAlgo broker calls
# ---------------------------------------------------------------------------
OPENALGO_REQUEST_TIMEOUT_MS=5000
OPENALGO_CRITICAL_MAX_RETRIES=2
OPENALGO_CRITICAL_RETRY_DELAY_MS=500
OPENALGO_NONCRITICAL_MAX_RETRIES=1
OPENALGO_NONCRITICAL_RETRY_DELAY_MS=2000

# ---------------------------------------------------------------------------
# Market blackout windows (IST, HH:MM) - broker calls are paused inside these.
# Crypto brokers are exempt and keep trading 24/7.
# ---------------------------------------------------------------------------
MARKET_BLACKOUT_QUOTES_START=02:00
MARKET_BLACKOUT_QUOTES_END=08:45
MARKET_BLACKOUT_GENERAL_START=03:00
MARKET_BLACKOUT_GENERAL_END=08:00

# ---------------------------------------------------------------------------
# WebSocket gateway
# ---------------------------------------------------------------------------
WS_GATEWAY_ENABLED=true
WS_GATEWAY_PATH=/stream

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false
# Mirror warn/error logs into the in-app notifications table.
LOG_NOTIFICATIONS=false

# NOTE: there is deliberately no HTTP rate-limit section here. The app has no rate-limiting
# middleware; the limits that matter are the per-instance broker ceilings, which live in the
# Settings screen under Broker Connection (rate_limits.*).
