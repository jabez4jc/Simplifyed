# Simplifyed Admin - environment configuration
# Copy to .env and fill in:
#
#   cp .env.example .env
#
# Only JWT_SECRET is required. Anything omitted falls back to the default shown here, and the
# Settings screen overrides the keys it covers at runtime.

# ---------------------------------------------------------------------------
# REQUIRED - the server refuses to start without this
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=                # signs login tokens, used for REST and the WebSocket gateway

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# NODE_ENV is a LABEL for logs and the startup banner - it does not switch behaviour.
NODE_ENV=development

PORT=3000

# Your public URL. Used to build the TradingView webhook URLs the app shows you.
BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Relative to backend/, or an absolute path.
DATABASE_PATH=./database/simplifyed.db

# ---------------------------------------------------------------------------
# Auth / access
# ---------------------------------------------------------------------------
# Bypasses login entirely and treats every request as an admin, and skips the instruments
# readiness check. NEVER enable in production.
ENABLE_TEST_MODE=false

# ---------------------------------------------------------------------------
# TradingView broadcast webhook
# ---------------------------------------------------------------------------
# The ONLY auth on POST /webhook/tradingview/broadcast, which places live orders.
# Treat as a trading credential. Send as the X-Webhook-Token header or ?token= query param.
# Leave empty to disable the endpoint (it rejects every request when unset).
# To replace it, use Settings -> Access Control -> Rotate token: the rotated token is stored in the
# database and takes precedence over this value from then on.
WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Telegram alerting (optional)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DEFAULT_CHAT_ID=
# If set, the webhook route requires Telegram's X-Telegram-Bot-Api-Secret-Token header to
# match. Must also be passed as secret_token when calling Telegram's setWebhook API.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# WebSocket gateway
# ---------------------------------------------------------------------------
WS_GATEWAY_ENABLED=true
WS_GATEWAY_PATH=/stream

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false
# Mirror warn/error logs into the in-app notifications table.
LOG_NOTIFICATIONS=false

# Per-instance broker rate limits live in Settings > Advanced > Broker connection, not here.
