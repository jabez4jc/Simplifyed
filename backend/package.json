{
  "name": "simplifyed-admin-v2",
  "version": "2.0.0",
  "description": "Simplifyed Admin - Trading Dashboard for OpenAlgo Instances",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "node build-css.js",
    "test": "node --test Test/**/*.test.js",
    "test:unit": "node --test Test/unit/**/*.test.js",
    "test:integration": "node --test Test/integration/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage Test/**/*.test.js",
    "test:watch": "node --test --watch Test/**/*.test.js",
    "migrate": "node migrations/migrate.js",
    "migrate:rollback": "node migrations/migrate.js rollback",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "keywords": [
    "trading",
    "openalgo",
    "dashboard",
    "stocks",
    "pnl"
  ],
  "author": "Simplifyed",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "connect-sqlite3": "^0.9.13",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "sqlite3": "^5.1.7",
    "undici": "^7.16.0",
    "winston": "^3.11.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "autoprefixer": "^10.4.22",
    "daisyui": "^5.5.5",
    "eslint": "^8.56.0",
    "postcss": "^8.5.6",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.14"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
